#!/usr/bin/env ruby
# frozen_string_literal: true

# No Bundler here: a Gemfile in the user's directory must not decide which
# gems load. The suite's own eval_helper.rb may `require "bundler/setup"`.
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "agent/evals"

Agent::Evals::Launcher.new(ARGV).execute!
